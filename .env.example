# Optional: enables structured AI roadmap generation.
OPENAI_API_KEY=

# Required for the commercial application.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional production identifier used only as a fail-closed comparison by
# destructive staging/test tooling. This is a project ref, never a secret.
SUPABASE_PRODUCTION_PROJECT_REF=

# Required when Cycle checkout is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set explicitly to true for the live Stripe project and false for staging/test.
STRIPE_EXPECTED_LIVEMODE=false

# Opt-in only: isolated staging payment integration suite. Never use production values.
PAYMENT_STAGING_BASE_URL=
PAYMENT_STAGING_SUPABASE_URL=
PAYMENT_STAGING_SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_STAGING_STRIPE_WEBHOOK_SECRET=

# Opt-in only: destructive direct-PostgREST/SQL attack suite for an isolated
# staging project. Never use production values. The acknowledgement must be
# exactly routefinder-isolated-staging-security.
SUPABASE_SECURITY_STAGING_URL=
SUPABASE_SECURITY_STAGING_ANON_KEY=
SUPABASE_SECURITY_STAGING_SERVICE_ROLE_KEY=
SUPABASE_SECURITY_STAGING_DB_URL=
SUPABASE_SECURITY_STAGING_PROJECT_REF=
SUPABASE_SECURITY_STAGING_ACK=

# Opt-in only: authenticated commercial Playwright against the same isolated
# project used by the locally started app. The acknowledgement must be exactly
# routefinder-isolated-commercial-e2e-v1.
COMMERCIAL_E2E_SUPABASE_URL=
COMMERCIAL_E2E_SUPABASE_ANON_KEY=
COMMERCIAL_E2E_SUPABASE_SERVICE_ROLE_KEY=
COMMERCIAL_E2E_SUPABASE_PROJECT_REF=
COMMERCIAL_E2E_ACK=

# Authorises Vercel cron calls that process expiry and catalogue sync.
CRON_SECRET=

# Comma-separated accounts allowed to review and publish catalogue records.
ADMIN_EMAILS=

# Official commercial catalogue integrations.
APPRENTICESHIP_API_KEY=
DISCOVER_UNI_DATASET_URL=
# Written permission/approval reference retained by the founder; do not enter a secret.
APPRENTICESHIP_SOURCE_APPROVAL_REFERENCE=
DISCOVER_UNI_SOURCE_APPROVAL_REFERENCE=
# Optional operations webhook for redacted catalogue failures and stale/backlog alerts.
CATALOGUE_ALERT_WEBHOOK_URL=

# Only for the isolated backup restore exercise. Never point the target at staging or production.
SUPABASE_STAGING_DB_URL=
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_RESTORE_TEST_DB_URL=
SUPABASE_RESTORE_TEST_URL=
SUPABASE_RESTORE_TEST_SERVICE_ROLE_KEY=
SUPABASE_RESTORE_TEST_PROJECT_REF=
RESTORE_TEST_ACK=

# Strict release orchestration. The acknowledgement must be exactly
# routefinder-release-verification-v1 and every selected suite flag must be 1.
RELEASE_VERIFY_ACK=
RELEASE_VERIFY_SUPABASE_SECURITY=
RELEASE_VERIFY_COMMERCIAL_E2E=
RELEASE_VERIFY_STRIPE_STAGING=
RELEASE_VERIFY_RESTORE=

# Optional: local prototype catalogue settings.
CATALOG_DB_PATH=data/catalog/catalog.sqlite
CATALOG_APPRENTICESHIP_SYNC_MINUTES=30
CATALOG_UNIVERSITY_SYNC_HOUR=2

# Set by continuous-integration runners; not needed for local app operation.
CI=
